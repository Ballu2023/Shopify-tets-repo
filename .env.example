# Copy to .env and fill. Never commit .env.
# App from the Shopify Dev Dashboard (Settings → Client ID / Client secret), installed on the store.
# Needed scopes: write_products, write_files, write_metaobject_definitions, write_metaobjects,
#                write_online_store_navigation, write_publications, read_publications, write_content
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Old-style custom app token (only if you don't use client id/secret):
SHOPIFY_ADMIN_TOKEN=
